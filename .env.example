# Copy to .env.local and fill in. Without a key, Pulse runs a scripted demo.
ANTHROPIC_API_KEY=

# Optional: rate limits for a public deployment (requests that call Claude).
# PULSE_LIMIT_HOURLY=15
# PULSE_LIMIT_DAILY=40
# PULSE_LIMIT_GLOBAL_DAILY=400

# Optional: Upstash Redis for shared rate limits (set automatically by the
# Vercel Marketplace integration). Without it, limits are kept in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
